# Copy to aws-lab.env (git-ignored), fill in, then copy it to the EC2 instance.
# Used for the AWS lab (docs/aws-ec2-deploy.md): one EC2 running mysql + redis + api.
COMPOSE_PROJECT_NAME=roomsplit-lab
ASPNETCORE_ENVIRONMENT=Staging

# Tag of the image built locally and loaded on the instance (git describe --tags --always).
API_TAG=
# Host port 80 so the API answers at http://<public-ip>/
API_PORT=80

MYSQL_ROOT_PASSWORD=
MYSQL_USER=roomsplit_app
MYSQL_PASSWORD=

# Redis has no host port here; the password only protects it inside the compose network.
REDIS_PASSWORD=
