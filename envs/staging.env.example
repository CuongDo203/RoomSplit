# Copy to staging.env (git-ignored) and fill in. Use passwords different from production.
COMPOSE_PROJECT_NAME=roomsplit-staging
ASPNETCORE_ENVIRONMENT=Staging

# Image tag built once and shared with production, e.g. the short git SHA.
API_TAG=
API_PORT=8081

MYSQL_ROOT_PASSWORD=
MYSQL_USER=roomsplit_app
MYSQL_PASSWORD=

# Redis has no host port here; the password only protects it inside the compose network.
REDIS_PASSWORD=
